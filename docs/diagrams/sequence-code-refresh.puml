@startuml sequence-code-refresh
!theme plain
title Sequence: Code Project Refresh (releases + Unreleased Commits note)

actor User
participant "Code Dashboard\nQuick Actions" as Block
participant "window.ZettelkastenOperator" as API
participant "CodeProjectManager" as CM
participant "GitHubClient" as GH
participant "GitHub API" as GitHub
participant "ConfirmModal" as Confirm
participant "Vault" as Vault

User -> Block : Click "Refresh" (PAT selected, or Public ticked)
Block -> API : refreshCodeProject(projectPath, tokenKey)
activate API
API -> CM : new CodeProjectManager(app, settings)\n.refreshProject(projectFile, tokenKey,\n{ confirmLegacyCleanup: askLegacyCommitCleanup })
activate CM

CM -> CM : frontmatter: repo, defaultBranch, github_token_key
alt repo missing
  CM --> API : throw "Missing repo field (owner/name)"
end
alt key given
  CM -> CM : secretStorage.getSecret(key)
  alt no secret
    CM --> API : throw 'No PAT found for key "..."' (no request sent)
  end
end

CM -> GH : listReleases(owner, repo)
GH -> GitHub : GET /repos/{owner}/{repo}/releases
GitHub --> GH : releases[] (or HTTP error)
GH --> CM : releases
note right of CM : HTTP error -> throw describeGitHubError(...)\n(401 PAT rejected, 403 access/limit, 404 repo)

loop each release
  alt releases/{tag}.md exists
    CM -> Vault : processFrontMatter(version, url, date, project)
  else
    CM -> Vault : createNote(...) then properties.set(url, ...)\nso ORM defaults do not drop the URL
  end
end

opt latest release exists
  CM -> GH : compareCommits(owner, repo, latestTag, defaultBranch)
  GH -> GitHub : GET /repos/.../compare/{tag}...{branch}
  GitHub --> GH : { total_commits, commits[] } (or HTTP error)
  GH --> CM : compare result
end

CM -> CM : buildUnreleasedCommitsNote(base, commits, total, truncated, error?)
CM -> Vault : create / modify "Unreleased Commits.md" (whole note)
note right of CM : Empty list when there is no release\nor the compare failed

alt compare failed
  CM --> API : throw "Synced N releases, but comparing ... failed (404): ..."
end

opt commits/*.md exist and dashboard legacy_commits != keep
  CM -> Confirm : confirmLegacyCleanup(count)
  Confirm -> User : "Remove old commit notes?"
  alt Move to trash
    CM -> Vault : fileManager.trashFile(file)\n(fallback vault.trash(file, true))
  else Keep them
    CM -> Vault : processFrontMatter(dashboard, legacy_commits = "keep")
  end
end

CM -> User : Notice("Synced N releases, M unreleased commits.")
CM --> API : { releases, unreleasedCommits, legacyCommitNotes }
deactivate CM
API --> Block : summary
deactivate API
note over Block : On a thrown error the script shows\nNotice("Refresh failed: <message>")

@enduml
