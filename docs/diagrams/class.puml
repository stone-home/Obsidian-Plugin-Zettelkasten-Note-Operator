@startuml class
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontStyle bold

title Zettelkasten Operator — Class Overview

package "Plugin Core" {
  class MyPlugin {
    + settings: ZettelkastenSettings
    + factory: NoteFactory
    + dataview?: DataviewCommand
    + lastPushRequestDebug?: LastPushRequestDebug
    --
    + onload(): Promise<void>
    + loadSettings(): Promise<void>
    + saveSettings(): Promise<void>
    - registerGlobalActions(): void
    + onunload(): void
  }

  class SampleSettingTab {
    - plugin: MyPlugin
    - activeTab: general | projects | dataview | templates
    - editingIndex: number | null
    - lastRenderKey: string | null
    --
    + display(): void
    - renderGeneralSettings(container)
    - renderProjectsSettings(container)
    - renderGithubPullRules(container)
    - renderDataviewSettings(container)
    - renderSummaryView(container)
    - renderDetailView(container, index)
  }

  class ZettelkastenSettings <<interface>> {
    fleetingPath / literaturePath / atomPath / permanentPath
    lexiconPath / hubPath
    researchRootPath
    projectRootPath
    dataviewEnabled
    dataviewQueryPath
    dataviewCodeBlockType
    dataviewReloadDefaultsOnLoad
    dataviewDefaultScriptHashes
    ganttStatusColors
    createNoteOptions
    aiPromptRules / aiPromptMaxDepth / ...
    githubPullRules: GithubPullRule[]
  }

  class GithubPullRule <<interface>> {
    id
    label?
    sourceDir
    filePattern
    target
  }
}

package "Service Layer" {
  class NoteFactory {
    - app: App
    - settings: ZettelkastenSettings
    + confirmOverwrite: (path) => Promise<boolean>
    --
    + initialize(settings): Promise<void>
    + openCreationModal(): void
    + createNoteFromOption(option, title): Promise<ZettelNoteModel | null>
    + createZettel(type, title, folder, config?, extra?): Promise<ZettelNoteModel>
    + loadNote(path): Promise<ZettelNoteModel>
    + loadActiveNote(): Promise<ZettelNoteModel>
  }

  class ResearchManager {
    - app: App
    - settings: ZettelkastenSettings
    --
    + createProject(name): Promise<TFile>
    + importExistingProject(folderPath): Promise<TFile>
    + createObjective(projectFile, title): Promise<TFile>
    + createStep(projectFile, objectiveFile, title): Promise<TFile>
    + createExperiment(projectFile, title): Promise<TFile>
    + createRequirement(projectFile, title): Promise<TFile>
    + createDraft(projectFile, title, templateConfig?): Promise<TFile>
    + listProjects(): Promise<TFile[]>
    + updateDashboardProperties(filePath, updates): Promise<void>
    + renderDraftsTable(container, projectPath, callbacks): void
    + pushToGitHub(projectFile, tokenKey?): Promise<PushResult>
    + setPullRules(projectFile, ids): Promise<void>
    + pullFromGitHub(projectFile, tokenKey?): Promise<PullSummary>
    - readPromptsOnBranch(client, owner, name, branch, folder)
    - pullOneFile(...): Promise<void>
    - ensureFolderPath(folderPath): Promise<void>
    - readPat(key): Promise<string>
    - createNote(...): Promise<TFile>
  }

  class CodeProjectManager {
    - app: App
    - settings: ZettelkastenSettings
    --
    + createProject(name): Promise<TFile>
    + importExistingProject(folderPath): Promise<TFile>
    + createRequirement(projectFile, title): Promise<TFile>
    + refreshProject(projectFile, tokenKey?, options?): Promise<RefreshSummary>
    + updateDashboardProperties(filePath, updates): Promise<void>
    + listProjects(): Promise<TFile[]>
    - createNote(...): Promise<TFile>
    - upsertRelease(folder, projectFile, release): Promise<void>
    - writeUnreleasedCommitsNote(folder, content): Promise<void>
    - cleanUpLegacyCommitNotes(projectFile, folder, options): Promise<number>
  }

  class "codeProjectManager (module)" as CodeModule <<functions>> {
    + buildUnreleasedCommitsNote(input): string
  }

  class DraftCompiler {
    - app: App
    - settings: ZettelkastenSettings
    --
    + resolveConfig(draftFile): Promise<CompileConfig | null>
    + compileDraft(draft, cfg): Promise<string>
    + updateManifest(cfg, sectionId, newPath): Promise<void>
    - processWikiLinks(line): Promise<string>
    - expandNote(noteName, fullContent): Promise<string>
  }

  class PromptGenerator {
    - app: App
    - settings: ZettelkastenSettings
    --
    + generatePrompt(draft): Promise<string>
    + extractAIPromptSection(content)
    - extractLinksInOrder(content): string[]
    - findRule(file, rules): AIPromptRule | null
    - resolveLinksWithRules(...)
    - cleanNarrative(content): string
    - buildPrompt(...): string
  }

  class GitHubClient {
    - token: string
    --
    + listReleases(owner, repo): Promise<any[]>
    + compareCommits(owner, repo, base, head): Promise<any>
    + graphql<T>(query, variables): Promise<T>
    + listDirectory(owner, repo, path, ref): Promise<any[]>
    + downloadRaw(owner, repo, path, ref): Promise<ArrayBuffer>
    - get(url, accept?)
    - contentsUrl(owner, repo, path, ref): string
  }

  class "github/errors" as GitHubErrors <<functions>> {
    + githubErrorStatus(err): number | undefined
    + describeGitHubError(err, action, authed, notFound): string
  }

  class "github/gitHash" as GitHash <<functions>> {
    + gitBlobSha(bytes): Promise<string>
    + bytesToBase64(bytes): string
  }

  class "github/repoPull" as RepoPull <<functions>> {
    + generateRuleId(existing): string
    + validatePullRule(rule): string | null
    + selectPullFiles(entries, rule): GitHubContentEntry[]
    + resolvePullTarget(projectFolder, target, fileName): string | null
  }
}

package "Dataview Layer" {
  class DataviewCommand {
    - app: App
    - plugin: MyPlugin
    - dataviewManager: DataviewJSManager
    - processorRegistered: boolean
    - pendingDvjsByKey: Map<string, PendingDvjsEntry>
    --
    + initialize(): Promise<void>
    + refresh(): Promise<void>
    + unload(): void
    - registerCodeBlockProcessor(): void
    - scheduleProcessDvjsBlock(source, el, ctx): void
    - runDvjsBlock(payload): Promise<void>
  }

  class DataviewJSManager {
    - scripts: Map<string, IDataviewScript>
    - scriptCache: Map<string, string>
    - scriptsFolder: string
    - options: DataviewJSManagerOptions
    - fileWatcherRef: EventRef[]
    --
    + onload(): Promise<void>
    + getScript(id): IDataviewScript | undefined
    + executeScript(scriptId, container, params, ctx?, component?): Promise<void>
    + createScript(id, name, content, options?): Promise<IDataviewScript>
    + cleanUpFileWatchers(): void
    - createDefaultScripts(): Promise<void>
    - loadAllScripts(): Promise<void>
    - loadScript(file): Promise<void>
    - registerFileWatchers(): void
  }

  class DataviewJSManagerOptions <<interface>> {
    getOverwriteDefaultsOnLoad?()
    getDefaultScriptState?()
    saveDefaultScriptState?(state)
    notify?(message)
  }

  class DataviewScriptBuilder {
    - manager: DataviewJSManager
    - script: Partial<IDataviewScript>
    --
    + id(id): this
    + name(name): this
    + description(desc): this
    + content(scriptContent): this
    + build(): Promise<IDataviewScript>
  }
}

package "UI Layer (Modals)" {
  class Dashboard {
    - settings: ZettelkastenSettings
    - factory: NoteFactory
    - onComplete: OnNoteCreateCallback
    --
    + onOpen(): void
    - renderQuickAccess(container)
    - renderNewNoteSection(container)
    - renderActiveNoteSection(container)
    - renderUpgradeSection(container)
    - renderCategoryGrid(container, types)
  }

  class ConfirmModal {
    - options: ConfirmOptions
    - onResult: (confirmed) => void
    --
    + onOpen(): void
    + onClose(): void
  }

  class SearchModal {
    - settings: ZettelkastenSettings
    - factory: NoteFactory
    --
    + onOpen(): void
    - performSearch(): void
    - addActiveNoteToResultSources(result)
    - handleCreateOpen(name): void
  }

  class TemplateGridModal {
    + onOpen(): void
  }

  class FileNameModal {
    + onOpen(): void
  }

  class ResearchProjectsModal {
    + onOpen(): void
  }

  class CodeProjectsModal {
    + onOpen(): void
  }

  class DataviewScriptEditorModal {
    + onOpen(): void
  }
}

' Relationships
MyPlugin --> NoteFactory : holds
MyPlugin --> DataviewCommand : holds (optional)
MyPlugin --> SampleSettingTab : adds tab
MyPlugin ..> ZettelkastenSettings : uses
MyPlugin ..> ResearchManager : creates on demand
MyPlugin ..> CodeProjectManager : creates on demand
MyPlugin ..> DraftCompiler : creates on demand
MyPlugin ..> PromptGenerator : creates on demand
MyPlugin ..> CodeProjectsModal : askLegacyCommitCleanup()

SampleSettingTab --> MyPlugin : plugin
SampleSettingTab ..> ZettelkastenSettings : edits
SampleSettingTab ..> RepoPull : rule ids, validation
SampleSettingTab --> DataviewScriptEditorModal : opens
ZettelkastenSettings o-- GithubPullRule

NoteFactory --> Dashboard : opens
NoteFactory --> ConfirmModal : confirmOverwrite
NoteFactory ..> ZettelkastenSettings : uses
Dashboard --> TemplateGridModal : opens
Dashboard --> FileNameModal : opens
Dashboard --> SearchModal : opens
Dashboard --> ResearchProjectsModal : opens
Dashboard --> CodeProjectsModal : opens
Dashboard --> NoteFactory : uses

CodeProjectsModal --> CodeProjectManager : uses
CodeProjectsModal --> ConfirmModal : legacy cleanup
ResearchProjectsModal --> ResearchManager : uses

DataviewCommand --> DataviewJSManager : holds
DataviewJSManager ..> DataviewJSManagerOptions : configured by
DataviewJSManager --> DataviewScriptBuilder : createScriptBuilder()

CodeProjectManager --> GitHubClient : releases, compare
CodeProjectManager ..> CodeModule
CodeProjectManager ..> GitHubErrors
ResearchManager --> GitHubClient : graphql, contents
ResearchManager ..> GitHash
ResearchManager ..> RepoPull
ResearchManager ..> GitHubErrors

@enduml
