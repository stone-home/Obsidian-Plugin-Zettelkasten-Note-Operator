{
  "name": "obsidian-plugin-zettelkasten-operator",
  "version": "1.7.1",
  "description": "This Plugin is used to manipulate notes with the following Zettelkasten rules.",
  "main": "src/main.ts",
  "scripts": {
    "prepare": "husky",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "start": "node dist/index.js",
    "dev": "node esbuild.config.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.{ts,json,md}\"",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "stone",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/language": "^6.12.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.12",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "8.51.0",
    "@typescript-eslint/parser": "8.51.0",
    "builtin-modules": "5.0.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "obsidian": "latest",
    "prettier": "3.7.4",
    "semantic-release": "^25.0.2",
    "ts-jest": "^29.4.6",
    "tslib": "2.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "date-fns": "^4.1.0",
    "markdown-note-orm": "^1.2.1",
    "winston": "^3.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stone-home/Obsidian-Plugin-Zettelkasten-Note-Operator.git"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "npm run typecheck"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
